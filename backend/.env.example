# Environment Configuration for Ideal Computer Education ERP System

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/ideal_computer_education
# For MongoDB Atlas (cloud): mongodb+srv://username:password@cluster.mongodb.net/ideal_computer_education

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production
JWT_EXPIRE=7d

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
# For Gmail, use App Passwords: https://support.google.com/accounts/answer/185833

# Server Configuration
PORT=5000
NODE_ENV=development

# File Upload Configuration
MAX_FILE_SIZE=5000000
UPLOAD_PATH=./uploads/

# Security Configuration
BCRYPT_ROUNDS=12

# Admin Default Credentials (for initial setup)
DEFAULT_ADMIN_EMAIL=admin@ideal.com
DEFAULT_ADMIN_PASSWORD=admin123

# Application Settings
APP_NAME=Ideal Computer Education
APP_URL=https://www.iceworld.info
COMPANY_NAME=Ideal Computer Education
COMPANY_ADDRESS=NEAR DAV COLLEGE, TITILAGARH, DIST-BALANGIR, ODISHA, PIN-767033
COMPANY_PHONE=9124280311, 9124280322
COMPANY_EMAIL=iceworldtlg.in@gmail.com

# Certificate Settings
CERTIFICATE_TEMPLATE_PATH=./templates/certificate.html
CERTIFICATE_LOGO_PATH=./public/images/logo.png

# Payment Settings (for future integration)
PAYMENT_GATEWAY=false
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Analytics (for future integration)
GOOGLE_ANALYTICS_ID=your_google_analytics_id
FACEBOOK_PIXEL_ID=your_facebook_pixel_id

# Social Media Links
FACEBOOK_URL=https://facebook.com/idealcomputer
INSTAGRAM_URL=https://instagram.com/idealcomputer
LINKEDIN_URL=https://linkedin.com/company/ideal-computer-education
YOUTUBE_URL=https://youtube.com/@idealcomputer

# Development Settings
DEBUG=true
LOG_LEVEL=info
